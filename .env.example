# Copie este arquivo ou use npm run setup:env. Nenhum valor abaixo é uma credencial real.
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/api/v1/signaling
DATABASE_URL=postgresql://arh:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:5432/arh
DATABASE_POOL_SIZE=5
POSTGRES_USER=arh
POSTGRES_DB=arh
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
# 32 bytes aleatórios codificados em base64. Necessária para segredos MFA.
MASTER_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64
ADMIN_SESSION_HOURS=8
DEVICE_CREDENTIAL_DAYS=30
TRUST_PROXY=0
# Para produção use domínios reais sob seu controle, DNS apontando à VPS.
PANEL_DOMAIN=painel.exemplo.com
API_DOMAIN=api.exemplo.com
TURN_DOMAIN=turn.exemplo.com
ACME_EMAIL=administrador@exemplo.com
TURN_PUBLIC_IP=REPLACE_WITH_PUBLIC_IPV4
TURN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
TURN_URLS=
STUN_URLS=
# Opcional: usar turns:turn.seudominio:5349?transport=tcp após instalar certificados.
TURN_TLS_ENABLED=0
# Só a chave pública age fica no servidor. A privada deve ficar offline.
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=14
# Sem Firebase: app aberto recebe pedidos por consulta autenticada.
FCM_PROJECT_ID=
# Opcional; use docker-compose.fcm.yml para montar o JSON fora do repositório.
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_HOST_FILE=
