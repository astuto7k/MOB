{
  "name": "android-remote-hub",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup:env": "node infrastructure/scripts/setup-env.mjs",
    "dev:api": "npm run dev -w @arh/api",
    "dev:web": "node infrastructure/scripts/with-env.mjs npm run dev -w @arh/web",
    "db:generate": "npm run db:generate -w @arh/api",
    "db:migrate": "npm run db:migrate -w @arh/api",
    "db:bootstrap": "npm run bootstrap -w @arh/api",
    "owner:reset": "node infrastructure/scripts/reset-owner.mjs --after-restore",
    "check:infra": "node infrastructure/scripts/validate-infra.mjs",
    "db:local": "pglite-server --db=./.local-db --port=54329 --host=127.0.0.1 --max-connections=8",
    "build": "npm run db:generate && npm run build -w @arh/shared && npm run build -w @arh/api && npm run build -w @arh/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run build -w @arh/shared && npm run test --workspaces --if-present",
    "test:integration": "node infrastructure/scripts/integration-test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-socket": "0.2.19",
    "dotenv": "17.2.3",
    "yaml": "2.9.1"
  }
}
